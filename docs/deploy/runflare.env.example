NODE_ENV=production
APP_EDITION=SAAS
API_PORT=3001
API_PREFIX=api
CORS_ORIGINS=https://__FILL_RUNFLARE_DOMAIN__
TRUST_PROXY=true
DATABASE_URL=postgresql://postgres:__FILL_PG_PASSWORD__@__FILL_PG_SERVICE_HOST__:5432/vdb?schema=public
REDIS_URL=__FILL_REDIS_CONNECTION_URL_FROM_RUNFLARE__
MONGODB_URI=mongodb://__FILL_MONGO_USERNAME__:__FILL_MONGO_PASSWORD__@__FILL_MONGO_SERVICE_HOST__:27017/vdb?authSource=admin
OTP_PEPPER=__GENERATE_SECRET__
SMS_PROVIDER=parsgreen
PARSGREEN_API_TOKEN=__FILL_PARSGREEN_API_TOKEN__
PARSGREEN_BASE_URL=https://sms.parsgreen.ir
PARSGREEN_ADD_NAME=true
JWT_SECRET=__GENERATE_SECRET__
JWT_EXPIRES_SECONDS=604800
PAYMENT_PROVIDER=zarinpal
ZARINPAL_MERCHANT_ID=__FILL_ZARINPAL_MERCHANT_ID__
ZARINPAL_SANDBOX=false
WEB_ORIGIN=https://__FILL_RUNFLARE_DOMAIN__
API_PUBLIC_URL=https://__FILL_RUNFLARE_DOMAIN__/api
LICENSE_PEPPER=__GENERATE_SECRET__
ANALYTICS_ENABLED=true
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/var/lib/vdb/object-storage
MEDIA_MAX_BYTES=10485760
FONT_MAX_BYTES=5242880
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS=5000
IMPORT_SYNC_MAX_ROWS=100
BACKUP_MAX_BYTES=104857600
PDF_RENDERER=playwright
MAP_STATIC_URL_TEMPLATE=none
PLATFORM_ADMIN_MOBILES=__FILL_YOUR_MOBILE_AS_E164_PLUS98__
PLATFORM_ADMIN_IP_ALLOWLIST=
BILLING_GRACE_DAYS=3
EXPORT_MAX_CONCURRENT_PER_BUSINESS=2
EXPORT_RATE_MAX=10
EXPORT_RATE_WINDOW_SECONDS=60
EXPORT_WORKER_CONCURRENCY=1
