# Root / shared (copy into apps as needed)
NODE_ENV=development
APP_EDITION=SAAS

# PostgreSQL (docker-compose → host port 5432)
DATABASE_URL=postgresql://vdb:vdb@localhost:5432/vdb?schema=public

# Redis (docker-compose → host port 6379)
REDIS_URL=redis://localhost:6379

# MongoDB (docker-compose → host port 27017)
MONGODB_URI=mongodb://localhost:27017/vdb

# API
API_PORT=3001
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Identity / OTP (API — change pepper in real deploys)
OTP_PEPPER=dev-only-otp-pepper-change-me
SMS_PROVIDER=fake
OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RATE_MAX=5
OTP_RATE_WINDOW_SECONDS=900

# JWT access token (no refresh token in MVP — re-OTP when expired)
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_EXPIRES_SECONDS=604800

# Billing / payments (SAAS)
PAYMENT_PROVIDER=fake
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001/api

# Installation license (SELF_HOSTED)
LICENSE_PEPPER=dev-only-license-pepper-change-me
LICENSE_ISSUER_SECRET=

# Document share links (optional; defaults to OTP_PEPPER when unset)
# SHARE_LINK_PEPPER=dev-only-share-pepper-change-me
SHARE_LINK_PASSWORD_MAX_ATTEMPTS=10
SHARE_LINK_PASSWORD_WINDOW_SECONDS=900
SHARE_LINK_SESSION_SECONDS=900

# Product analytics (views/downloads) — set false to opt out install-wide
ANALYTICS_ENABLED=true

# Object storage (media)
STORAGE_DRIVER=local
MEDIA_MAX_BYTES=10485760
FONT_MAX_BYTES=5242880
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS=5000
IMPORT_SYNC_MAX_ROWS=100
# Workspace backup ZIP upload max (100MB default)
BACKUP_MAX_BYTES=104857600
# PDF export: fake (tests/dev without Chromium) | playwright (needs `npx playwright install chromium`)
PDF_RENDERER=fake
MAP_STATIC_URL_TEMPLATE=none
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vdb
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_FORCE_PATH_STYLE=true

# SAAS platform admin (ADR 031) — comma-separated mobiles seeded as platform_admins
# PLATFORM_ADMIN_MOBILES=09121234567
# Optional IP allowlist for /api/platform-admin/* (empty = allow all; set behind reverse proxy)
# PLATFORM_ADMIN_IP_ALLOWLIST=127.0.0.1,::1

# SAAS subscription grace after endsAt (writable days before expired)
BILLING_GRACE_DAYS=3

# HTTP hardening (ADR 033)
# TRUST_PROXY=true
EXPORT_MAX_CONCURRENT_PER_BUSINESS=2
EXPORT_RATE_MAX=10
EXPORT_RATE_WINDOW_SECONDS=60
EXPORT_WORKER_CONCURRENCY=1
