# NestJS API
NODE_ENV=development
APP_EDITION=SAAS
API_PORT=3001
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://vdb:vdb@localhost:5432/vdb?schema=public
REDIS_URL=redis://localhost:6379
MONGODB_URI=mongodb://localhost:27017/vdb

# Identity / OTP (change pepper in real deploys)
OTP_PEPPER=dev-only-otp-pepper-change-me
SMS_PROVIDER=parsgreen
# Fill after create — Authorization: basic apikey:{PARSGREEN_API_TOKEN}
PARSGREEN_API_TOKEN=5773566A-66ED-4409-8F31-B5DD16E51BB0
PARSGREEN_BASE_URL=https://sms.parsgreen.ir
PARSGREEN_ADD_NAME=true
OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RATE_MAX=5
OTP_RATE_WINDOW_SECONDS=900

# JWT access token (no refresh token in MVP — re-OTP when expired)
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_EXPIRES_SECONDS=604800

# Billing / payments (SAAS platform checkout; ignored for SELF_HOSTED license path)
PAYMENT_PROVIDER=fake
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001/api

# Installation license (SELF_HOSTED — raw key hashed with LICENSE_PEPPER)
LICENSE_PEPPER=dev-only-license-pepper-change-me
# Empty = accept local opaque keys like VDB-DEV-LICENSE-KEY-0001
# Production: set issuer secret and issue VDB1.<payload>.<hmac> keys
LICENSE_ISSUER_SECRET=

# Object storage (media library)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=
MEDIA_MAX_BYTES=10485760
FONT_MAX_BYTES=5242880
PDF_RENDERER=fake
# Map PDF static image: `none` = labeled placeholder; or template with {lat},{lng},{zoom},{w},{h},{markers}
MAP_STATIC_URL_TEMPLATE=none
# When STORAGE_DRIVER=s3 (MinIO / S3-compatible):
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vdb
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_FORCE_PATH_STYLE=true
