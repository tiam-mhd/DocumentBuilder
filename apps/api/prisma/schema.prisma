/**
 * Media albums (ContentModule). Gated by module.gallery —
 * see `.cursor/rules/14-content-entities.mdc`.
 */
model Gallery {
  id          String        @id @default(cuid())
  businessId  String        @map("business_id")
  name        String
  description String        @default("")
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items       GalleryItem[]

  @@index([businessId, deletedAt, sortOrder])
  @@map("galleries")
}

model GalleryItem {
  id         String    @id @default(cuid())
  businessId String    @map("business_id")
  galleryId  String    @map("gallery_id")
  mediaId    String    @map("media_id")
  caption    String    @default("")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  gallery    Gallery   @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([businessId, galleryId, deletedAt, sortOrder])
  @@index([businessId, mediaId])
  @@map("gallery_items")
}

/**
 * Shared geography for Projects, Branches, and Map (P02-T06).
 * Foundational Content — see `.cursor/rules/14-content-entities.mdc`.
 */
model Location {
  id          String    @id @default(cuid())
  businessId  String    @map("business_id")
  name        String
  country     String    @default("")
  province    String    @default("")
  city        String    @default("")
  address     String    @default("")
  lat         Float
  lng         Float
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  projects    Project[]
  branches    Branch[]

  @@index([businessId, deletedAt, name])
  @@index([businessId, lat, lng])
  @@map("locations")
}

/**
 * Company timeline events (ContentModule). Gated by module.timeline —
 * see `.cursor/rules/14-content-entities.mdc`.
 */
model TimelineEvent {
  id           String    @id @default(cuid())
  businessId   String    @map("business_id")
