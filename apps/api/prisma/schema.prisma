generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum SubscriptionStatus {
  trial
  active
  grace
  expired
  pending_payment
}

enum InvoiceStatus {
  open
  paid
  void
}

enum PaymentStatus {
  pending
  paid
  failed
  canceled
}

enum PaymentProvider {
  fake
  zarinpal
}

model User {
  id               String               @id @default(cuid())
  mobile           String               @unique
  displayName      String?              @map("display_name")
  email            String?
  jobTitle         String?              @map("job_title")
  bio              String?
  /** scrypt hash; null = OTP-only until user sets a password. */
  passwordHash     String?              @map("password_hash")
  twoFactorEnabled Boolean              @default(false) @map("two_factor_enabled")
  trialConsumed    Boolean              @default(false) @map("trial_consumed")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  memberships      BusinessMembership[]
  invitationsSent  BusinessInvitation[] @relation("InvitationInviter")
  auditEvents      AuditEvent[]
  platformAdmin    PlatformAdmin?

  @@map("users")
}

/**
 * SAAS platform operators (ADR 031). Not a Business membership role.
 */
model PlatformAdmin {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_admins")
}

/** Append-only audit log — see `.cursor/rules/15-audit-events.mdc`. */
model AuditEvent {
  id         String    @id @default(cuid())
  businessId String?   @map("business_id")
  userId     String?   @map("user_id")
  action     String
  entityType String    @map("entity_type")
  entityId   String?   @map("entity_id")
  meta       Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at")
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

model Business {
  id           String               @id @default(cuid())
  name         String
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")
  /** SAAS platform suspension (ADR 031) — blocks writable work. */
  suspendedAt       DateTime? @map("suspended_at")
  suspendedReason   String?   @map("suspended_reason")
  suspendedByUserId String?   @map("suspended_by_user_id")
  memberships  BusinessMembership[]
  invitations  BusinessInvitation[]
  subscription Subscription?
  invoices     Invoice[]
  payments     Payment[]
  mediaAssets  MediaAsset[]
  fontFaces    FontFace[]
  designThemes DesignTheme[]
  branding     BusinessBranding?
  templates    DocumentTemplate[]
  documents    Document[]
  exportJobs   ExportJob[]
  importJobs   ImportJob[]
  documentVersions DocumentVersion[]
  documentComments DocumentComment[]
  documentShareLinks DocumentShareLink[]
  analyticsEvents AnalyticsEvent[]
  projectCategories ProjectCategory[]
  projects     Project[]
  teamMembers  TeamMember[]
  branches     Branch[]
  services     BusinessService[]
  clients      Client[]
  certificates Certificate[]
  galleries    Gallery[]
  galleryItems GalleryItem[]
  locations    Location[]
  timelineEvents TimelineEvent[]
  auditEvents  AuditEvent[]
  workspaceBackupJobs WorkspaceBackupJob[]
  workspaceRestoreJobs WorkspaceRestoreJob[]

  @@index([suspendedAt])
  @@map("businesses")
}

model BusinessMembership {
  id         String         @id @default(cuid())
  businessId String         @map("business_id")
  userId     String         @map("user_id")
  role       MembershipRole @default(EDITOR)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId])
  @@map("business_memberships")
}

model BusinessInvitation {
  id              String           @id @default(cuid())
  businessId      String           @map("business_id")
  mobile          String
  role            MembershipRole
  token           String           @unique
  status          InvitationStatus @default(pending)
  invitedByUserId String           @map("invited_by_user_id")
  expiresAt       DateTime         @map("expires_at")
  acceptedAt      DateTime?        @map("accepted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy       User             @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([mobile, status])
  @@index([businessId, mobile])
  @@map("business_invitations")
}

model Plan {
  id               String         @id @default(cuid())
  code             String         @unique
  nameKey          String         @map("name_key")
  descriptionKey   String         @map("description_key")
  priceMonthly     Int            @map("price_monthly")
  currency         String         @default("IRR")
  baseEntitlements Json           @map("base_entitlements")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  planModules      PlanModule[]
  subscriptions    Subscription[]

  @@map("plans")
}

model CatalogModule {
  id             String               @id @default(cuid())
  code           String               @unique
  nameKey        String               @map("name_key")
  descriptionKey String               @map("description_key")
  priceMonthly   Int                  @map("price_monthly")
  currency       String               @default("IRR")
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  planModules    PlanModule[]
  addons         SubscriptionModule[]

  @@map("catalog_modules")
}

model PlanModule {
  planId   String        @map("plan_id")
  moduleId String        @map("module_id")
  plan     Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  module   CatalogModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([planId, moduleId])
  @@map("plan_modules")
}

model Subscription {
  id         String               @id @default(cuid())
  businessId String               @unique @map("business_id")
  planId     String?              @map("plan_id")
  status     SubscriptionStatus
  startsAt   DateTime             @map("starts_at")
  endsAt     DateTime?            @map("ends_at")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")
  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan       Plan?                @relation(fields: [planId], references: [id], onDelete: SetNull)
  modules    SubscriptionModule[]
  invoices   Invoice[]
  dunningNotices SubscriptionDunningNotice[]

  @@index([status])
  @@index([status, endsAt])
  @@map("subscriptions")
}

/**
 * Idempotent dunning SMS ledger (ADR 032).
 * periodKey = subscription endsAt date (UTC YYYY-MM-DD) for the billed period.
 */
model SubscriptionDunningNotice {
  id             String       @id @default(cuid())
  subscriptionId String       @map("subscription_id")
  businessId     String       @map("business_id")
  kind           String
  periodKey      String       @map("period_key")
  sentAt         DateTime     @default(now()) @map("sent_at")
  meta           Json         @default("{}")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, kind, periodKey])
  @@index([businessId, sentAt])
  @@map("subscription_dunning_notices")
}

model Invoice {
  id             String        @id @default(cuid())
  businessId     String        @map("business_id")
  subscriptionId String        @map("subscription_id")
  planId         String        @map("plan_id")
  status         InvoiceStatus @default(open)
  amount         Int
  currency       String        @default("IRR")
  lineItems      Json          @map("line_items")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@index([businessId])
  @@index([subscriptionId])
  @@map("invoices")
}

model Payment {
  id             String          @id @default(cuid())
  businessId     String          @map("business_id")
  invoiceId      String          @map("invoice_id")
  provider       PaymentProvider
  status         PaymentStatus   @default(pending)
  amount         Int
  currency       String          @default("IRR")
  gatewayRef     String?         @unique @map("gateway_ref")
  providerRef    String?         @map("provider_ref")
  idempotencyKey String?         @unique @map("idempotency_key")
  paidAt         DateTime?       @map("paid_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([invoiceId])
  @@index([status])
  @@map("payments")
}

model SubscriptionModule {
  id             String        @id @default(cuid())
  subscriptionId String        @map("subscription_id")
  moduleId       String        @map("module_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  module         CatalogModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, moduleId])
  @@map("subscription_modules")
}

/** Install-wide license for SELF_HOSTED (not per-business). Raw key never stored. */
model InstallationLicense {
  id               String    @id @default(cuid())
  keyHash          String    @unique @map("key_hash")
  keyHint          String    @map("key_hint")
  organizationName String?   @map("organization_name")
  activatedAt      DateTime  @map("activated_at")
  expiresAt        DateTime? @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([revokedAt, expiresAt])
  @@map("installation_licenses")
}

enum MediaAssetStatus {
  ready
  processing
  failed
}

/** Business-scoped media metadata; binaries live in object storage. */
model MediaAsset {
  id           String           @id @default(cuid())
  businessId   String           @map("business_id")
  originalName String           @map("original_name")
  mimeType     String           @map("mime_type")
  byteSize     Int              @map("byte_size")
  width        Int?
  height       Int?
  storageKey   String           @map("storage_key")
  thumbKey     String?          @map("thumb_key")
  webKey       String?          @map("web_key")
  printKey     String?          @map("print_key")
  status       MediaAssetStatus @default(ready)
  meta         Json?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  deletedAt    DateTime?        @map("deleted_at")
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, deletedAt, createdAt])
  @@index([businessId, originalName])
  @@map("media_assets")
}

enum FontStyle {
  normal
  italic
}

/** Business-scoped font face for Theme + PDF embed. Binary in object storage. */
model FontFace {
  id           String    @id @default(cuid())
  businessId   String    @map("business_id")
  family       String
  weight       Int       @default(400)
  style        FontStyle @default(normal)
  originalName String    @map("original_name")
  mimeType     String    @map("mime_type")
  byteSize     Int       @map("byte_size")
  storageKey   String    @map("storage_key")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, deletedAt, family])
  @@index([businessId, family, weight, style])
  @@map("font_faces")
}

/**
 * Document brand theme (colors / typography / optional font_faces refs).
 * Not app chrome dark/light — see `.cursor/rules/12-design-themes.mdc`.
 */
model DesignTheme {
  id         String    @id @default(cuid())
  businessId String    @map("business_id")
  name       String
  isDefault  Boolean   @default(false) @map("is_default")
  tokens     Json
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, deletedAt, isDefault])
  @@index([businessId, deletedAt, createdAt])
  templates DocumentTemplate[]
  @@map("design_themes")
}

/**
 * White-label chrome brand per Business — see `.cursor/rules/18-white-label-branding.mdc`.
 * Separate from design_themes (document PDF tokens).
 */
model BusinessBranding {
  id              String   @id @default(cuid())
  businessId      String   @unique @map("business_id")
  displayName     String?  @map("display_name")
  primaryColor    String?  @map("primary_color")
  logoStorageKey  String?  @map("logo_storage_key")
  logoMimeType    String?  @map("logo_mime_type")
  logoByteSize    Int?     @map("logo_byte_size")
  customDomain    String?  @unique @map("custom_domain")
  hidePoweredBy   Boolean  @default(false) @map("hide_powered_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_branding")
}

/**
 * SAAS global template catalog (ADR 029). Not business-owned.
 * Install copies into document_templates + Mongo template_bodies.
 */
model MarketplaceTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  locale      String   @default("fa")
  /** TemplateBody-shaped JSON (validated on write/install). */
  body        Json
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("marketplace_templates")
}

/**
 * Template metadata (layout only). Body lives in Mongo `template_bodies`.
 * See `.cursor/rules/13-templates-blocks.mdc`.
 */
model DocumentTemplate {
  id          String       @id @default(cuid())
  businessId  String       @map("business_id")
  themeId     String?      @map("theme_id")
  name        String
  description String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  theme       DesignTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)
  documents   Document[]

  @@index([businessId, deletedAt, createdAt])
  @@index([businessId, name])
  @@map("document_templates")
}

enum DocumentStatus {
  draft
  review
  approved
  published
}

/**
 * Document instance metadata. Body in Mongo `document_bodies`.
 * Data ≠ Template ≠ Document — see `.cursor/rules/13-templates-blocks.mdc`.
 */
model Document {
  id              String           @id @default(cuid())
  businessId      String           @map("business_id")
  templateId      String?          @map("template_id")
  title           String
  /** Content locale for preview/PDF (ADR 015). Columns default fa. */
  locale          String           @default("fa")
  status          DocumentStatus   @default(draft)
  /** Public web profile slug — unique per business when set (ADR 026). */
  webSlug         String?          @map("web_slug")
  webPublished    Boolean          @default(false) @map("web_published")
  webPublishedAt  DateTime?        @map("web_published_at")
  /** Denormalized analytics rollups (ADR 028). */
  analyticsViewCount     Int @default(0) @map("analytics_view_count")
  analyticsDownloadCount Int @default(0) @map("analytics_download_count")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  template        DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  exportJobs      ExportJob[]
  versions        DocumentVersion[]
  comments        DocumentComment[]
  shareLinks      DocumentShareLink[]
  analyticsEvents AnalyticsEvent[]

  @@unique([businessId, webSlug])
  @@index([businessId, deletedAt, createdAt])
  @@index([businessId, status, deletedAt])
  @@index([businessId, webPublished, webSlug])
  @@map("documents")
}

enum ShareLinkScope {
  web
  pdf
}

/** Tokenized share access — ADR 027. Independent of web_published slug. */
model DocumentShareLink {
  id              String         @id @default(cuid())
  businessId      String         @map("business_id")
  documentId      String         @map("document_id")
  tokenHash       String         @unique @map("token_hash")
  tokenHint       String         @map("token_hint")
  passwordHash    String?        @map("password_hash")
  scope           ShareLinkScope
  expiresAt       DateTime?      @map("expires_at")
  revokedAt       DateTime?      @map("revoked_at")
  createdByUserId String?        @map("created_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  document        Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([businessId, documentId, createdAt])
  @@index([businessId, revokedAt])
  @@map("document_share_links")
}

enum AnalyticsEventKind {
  view
  download
}

enum AnalyticsEventSource {
  web_publish
  share_web
  share_pdf
  export_download
}

/** Product metrics — ADR 028. Not audit_events. */
model AnalyticsEvent {
  id         String               @id @default(cuid())
  businessId String               @map("business_id")
  documentId String               @map("document_id")
  kind       AnalyticsEventKind
  source     AnalyticsEventSource
  /** ISO-3166-1 alpha-2 when known; never store IP. */
  country    String?
  /** Coarse device class — never raw User-Agent. */
  device     String?
  createdAt  DateTime             @default(now()) @map("created_at")
  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  document   Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, documentId, kind, createdAt])
  @@index([businessId, kind, createdAt])
  @@map("analytics_events")
}

/** Review comments on a document — ADR 022. Mentions out of MVP. */
model DocumentComment {
  id               String    @id @default(cuid())
  businessId       String    @map("business_id")
  documentId       String    @map("document_id")
  authorUserId     String    @map("author_user_id")
  body             String
  /** Optional DocumentBody page id. */
  pageId           String?   @map("page_id")
  /** Optional BlockNode id (element anchor). */
  blockId          String?   @map("block_id")
  resolvedAt       DateTime? @map("resolved_at")
  resolvedByUserId String?   @map("resolved_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  document         Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([businessId, documentId, deletedAt, createdAt])
  @@index([businessId, documentId, resolvedAt])
  @@map("document_comments")
}

enum DocumentVersionSource {
  publish
  manual
}

/** Immutable document version metadata — body snapshot in Mongo `document_version_bodies`. */
model DocumentVersion {
  id              String                @id @default(cuid())
  businessId      String                @map("business_id")
  documentId      String                @map("document_id")
  versionNumber   Int                   @map("version_number")
  source          DocumentVersionSource
  note            String?
  title           String
  locale          String                @default("fa")
  status          DocumentStatus
  createdByUserId String?               @map("created_by_user_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  document        Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([businessId, documentId, createdAt])
  @@map("document_versions")
}

enum ExportJobStatus {
  queued
  processing
  completed
  failed
}

/** PDF (and future) export jobs — binary in ObjectStorage; queue on Redis/BullMQ. */
model ExportJob {
  id           String          @id @default(cuid())
  businessId   String          @map("business_id")
  documentId   String          @map("document_id")
  status       ExportJobStatus @default(queued)
  errorCode    String?         @map("error_code")
  errorMessage String?         @map("error_message")
  storageKey   String?         @map("storage_key")
  byteSize     Int?            @map("byte_size")
  mimeType     String          @default("application/pdf") @map("mime_type")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  startedAt    DateTime?       @map("started_at")
  finishedAt   DateTime?       @map("finished_at")
  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  document     Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([businessId, documentId, createdAt])
  @@index([businessId, status, createdAt])
  @@map("export_jobs")
}

enum ImportJobStatus {
  uploaded
  mapped
  queued
  processing
  completed
  failed
}

enum ImportEntityType {
  projects
}

enum ImportFileFormat {
  csv
  xlsx
}

/** Bulk content import jobs — file in ObjectStorage; queue on Redis/BullMQ when large. */
model ImportJob {
  id               String           @id @default(cuid())
  businessId       String           @map("business_id")
  createdByUserId  String           @map("created_by_user_id")
  entityType       ImportEntityType @map("entity_type")
  status           ImportJobStatus  @default(uploaded)
  format           ImportFileFormat
  originalFilename String           @map("original_filename")
  mimeType         String           @map("mime_type")
  byteSize         Int              @map("byte_size")
  storageKey       String           @map("storage_key")
  /** Column header → field key (title, description, …). */
  mapping          Json?
  /** headers, totalRows, sampleRows, errorCounts / sample errors. */
  preview          Json?
  /** created, skipped, errors[]. */
  result           Json?
  errorCode        String?          @map("error_code")
  errorMessage     String?          @map("error_message")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  startedAt        DateTime?        @map("started_at")
  finishedAt       DateTime?        @map("finished_at")
  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
  @@map("import_jobs")
}

enum WorkspaceBackupStatus {
  queued
  processing
  completed
  failed
}

enum WorkspaceRestoreStatus {
  uploaded
  queued
  processing
  completed
  failed
}

/** Business workspace ZIP backup — ADR 024 / `.cursor/rules/16-backup-restore.mdc`. */
model WorkspaceBackupJob {
  id              String                @id @default(cuid())
  businessId      String                @map("business_id")
  createdByUserId String                @map("created_by_user_id")
  status          WorkspaceBackupStatus @default(queued)
  storageKey      String?               @map("storage_key")
  byteSize        Int?                  @map("byte_size")
  mimeType        String                @default("application/zip") @map("mime_type")
  manifest        Json?
  errorCode       String?               @map("error_code")
  errorMessage    String?               @map("error_message")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  startedAt       DateTime?             @map("started_at")
  finishedAt      DateTime?             @map("finished_at")
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
  @@map("workspace_backup_jobs")
}

/** Business workspace ZIP restore — upload → preview → commit. */
model WorkspaceRestoreJob {
  id              String                 @id @default(cuid())
  businessId      String                 @map("business_id")
  createdByUserId String                 @map("created_by_user_id")
  status          WorkspaceRestoreStatus @default(uploaded)
  storageKey      String                 @map("storage_key")
  byteSize        Int                    @map("byte_size")
  mimeType        String                 @default("application/zip") @map("mime_type")
  originalFilename String                @map("original_filename")
  preview         Json?
  result          Json?
  confirmReplace  Boolean                @default(false) @map("confirm_replace")
  errorCode       String?                @map("error_code")
  errorMessage    String?                @map("error_message")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  startedAt       DateTime?              @map("started_at")
  finishedAt      DateTime?              @map("finished_at")
  business        Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
  @@map("workspace_restore_jobs")
}

/**
 * Portfolio categories (ContentModule). Gated by module.projects —
 * see `.cursor/rules/14-content-entities.mdc`.
 */
model ProjectCategory {
  id           String    @id @default(cuid())
  businessId   String    @map("business_id")
  name         String
  translations Json      @default("{}")
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@index([businessId, deletedAt, sortOrder])
  @@map("project_categories")
}

enum ProjectStatus {
  draft
  published
  archived
}

/**
 * Business portfolio / project rows. Flexible `fields` JSONB; optional
 * FK to shared `locations` (P02-T05).
 */
model Project {
  id           String           @id @default(cuid())
  businessId   String           @map("business_id")
  categoryId   String?          @map("category_id")
  title        String
  description  String           @default("")
  translations Json             @default("{}")
  status       ProjectStatus    @default(draft)
  coverMediaId String?          @map("cover_media_id")
  mediaIds     Json             @default("[]") @map("media_ids")
  locationId   String?          @map("location_id")
  fields       Json             @default("{}")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  deletedAt    DateTime?        @map("deleted_at")
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category     ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location     Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([businessId, deletedAt, createdAt])
  @@index([businessId, status, deletedAt])
  @@index([businessId, categoryId, deletedAt])
  @@index([businessId, locationId])
  @@map("projects")
}

/**
 * Team roster (ContentModule). Foundational Business Data for Org Chart —
 * see `.cursor/rules/14-content-entities.mdc`.
 */
model TeamMember {
  id             String      @id @default(cuid())
  businessId     String      @map("business_id")
  branchId       String?     @map("branch_id")
  parentMemberId String?     @map("parent_member_id")
  name           String
  roleTitle      String      @default("") @map("role_title")
  department     String      @default("")
  translations   Json        @default("{}")
  photoMediaId   String?     @map("photo_media_id")
  sortOrder      Int         @default(0) @map("sort_order")
  fields         Json        @default("{}")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch         Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  parent         TeamMember? @relation("TeamReporting", fields: [parentMemberId], references: [id], onDelete: SetNull)
  reports        TeamMember[] @relation("TeamReporting")

  @@index([businessId, deletedAt, sortOrder])
  @@index([businessId, branchId, deletedAt])
  @@index([businessId, parentMemberId, deletedAt])
  @@map("team_members")
}

/**
 * Company branches / offices. Optional FK to shared `locations`.
 */
model Branch {
  id           String       @id @default(cuid())
  businessId   String       @map("business_id")
  name         String
  addressLine1 String       @default("") @map("address_line1")
  addressLine2 String       @default("") @map("address_line2")
  city         String       @default("")
  province     String       @default("")
  postalCode   String       @default("") @map("postal_code")
  country      String       @default("")
  phone        String       @default("")
  translations Json         @default("{}")
  locationId   String?      @map("location_id")
  sortOrder    Int          @default(0) @map("sort_order")
  fields       Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  teamMembers  TeamMember[]

  @@index([businessId, deletedAt, sortOrder])
  @@index([businessId, locationId])
  @@map("branches")
}

